# Скопируйте в .env и при необходимости поменяйте. Все значения необязательны — есть безопасные для демо умолчания.
POSTGRES_DB=credit
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit
# Секрет подписи токенов. В любом окружении кроме локального — длинная случайная строка.
SECRET_KEY=change-me-to-a-long-random-string-in-production
# Вход в один клик под тестовыми учётками и загрузка демо-данных.
DEMO_MODE=true
SEED_ON_START=true
# Искусственная задержка ответа эмулятора ЕГРЮЛ/БКИ/ФНС, мс — чтобы этапы конвейера были видны.
MOCK_LATENCY_MS=400
# Пауза между этапами конвейера, с — чтобы на демо было видно, как заявка движется. 0 — без пауз.
PIPELINE_STEP_DELAY_S=1.5
