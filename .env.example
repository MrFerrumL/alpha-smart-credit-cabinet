# Скопируйте в .env и поменяйте, что нужно. Все строки необязательны, умолчаний хватает для демо.
POSTGRES_DB=credit
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit
# Ключ подписи токенов. Если не задан, backend при старте создаёт случайный, и после его перезапуска нужно войти
# заново. Для любого стенда, кроме демо, задайте длинную случайную строку.
# SECRET_KEY=
# Демо-режим: демо-учётки, Swagger и код подписи в окне подписания. При false ничего этого нет.
DEMO_MODE=true
SEED_ON_START=true
# Кабинет открыт только с этой машины. 0.0.0.0 открывает его другим устройствам в сети.
# FRONTEND_BIND=0.0.0.0
# Задержка ответов эмулятора ЕГРЮЛ, ФНС и БКИ, мс, чтобы этапы конвейера было видно.
MOCK_LATENCY_MS=400
# Пауза между этапами конвейера, с. 0 — без пауз.
PIPELINE_STEP_DELAY_S=1.5
# Пояснение решения простыми словами, по умолчанию выключено. Подробно — в docs/llm.md.
# Только модели с открытыми весами: локальная Ollama, профиль llm или ваш сервер (vLLM, llama.cpp, Ollama).
# LLM_ENABLED=true
# Профиль llm запускает Ollama в Docker на процессоре (ПК с 16 ГБ памяти).
# COMPOSE_PROFILES=llm
# Адрес OpenAI-совместимого API сервера модели, без /chat/completions. Для Ollama на этом ПК —
# http://host.docker.internal:11434/v1.
# LLM_BASE_URL=http://ollama:11434/v1
# Ключ, если ваш сервер модели его требует.
# LLM_API_KEY=
# LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
